# ============================================================================
#  Agenda en línea — Google Calendar
#  Copia este archivo a .env.local y llena los valores. NUNCA lo subas al repo.
#  Sin estas variables el sitio NO se rompe: la agenda muestra todos los
#  horarios y la cita se termina de confirmar por WhatsApp.
# ============================================================================

# Credenciales OAuth (Google Cloud Console → APIs y servicios → Credenciales →
# ID de cliente de OAuth, tipo "Aplicación web").
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Refresh token de la cuenta de Google de la clínica.
# Se genera una sola vez con:  node scripts/google-auth.mjs
GOOGLE_REFRESH_TOKEN=""

# Calendario donde se crean las citas. "primary" = el principal de esa cuenta.
GOOGLE_CALENDAR_ID="primary"

# Zona horaria de la clínica (define a qué hora real corresponde cada slot).
CLINIC_TIMEZONE="America/Bogota"
